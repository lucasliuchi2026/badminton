# ===== 打球吗 backend 环境变量示例（复制为 .env 或直接 set）=====
# JWT 签名密钥，生产环境必须换成随机长字符串
JWT_SECRET=change-me-to-a-random-string

# 小程序账号的 AppID/AppSecret（注意：公众号测试号的那对不行）。留空则启用 dev 登录模式，无需微信服务器
WECHAT_APPID=
WECHAT_SECRET=

# SQLite 数据库文件位置（fly.io 部署时挂卷到 /data）
DATABASE_URL=sqlite:///./badminton.db

# 活动素材（照片/视频）本地存储目录
UPLOAD_DIR=./uploads
