<view class="card" style="padding:16rpx 28rpx">
  <input class="field-input" style="border:none;margin:0;padding:8rpx 0" placeholder="🔍 搜索活动名称 / 场地" bindinput="onSearch" confirm-type="search" />
</view>

<view wx:for="{{list}}" wx:key="id" class="card" bindtap="openDetail" data-id="{{item.id}}">
  <view class="row between">
    <view class="title">{{item.name}}<text class="badge badge-gray">已结束</text></view>
    <text class="mini">{{item.date}}</text>
  </view>
  <view style="margin-top:12rpx"><text class="badge {{item.typeCls}}">{{item.typeText}}</text></view>
  <view class="sub" style="margin-top:12rpx">📍 {{item.venue}} · {{item.signed_total}} 人参与</view>
  <view class="mini" style="margin-top:12rpx">查看旧素材与活动回顾 ›</view>
</view>

<view wx:if="{{!list.length}}" class="mini" style="text-align:center;padding:60rpx">没有匹配的历史活动</view>
