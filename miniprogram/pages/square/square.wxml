<view class="hero" wx:if="{{group}}">
  <view class="club">🏸 {{group.club_name}}</view>
  <view class="slogan">{{group.slogan}}</view>
  <view class="intro">{{group.intro}}</view>
  <view class="hero-stats">
    <view><view class="v">{{list.length}}</view><view class="k">近期活动</view></view>
    <view><view class="v">{{totalSigned}}</view><view class="k">累计已报名</view></view>
  </view>
</view>

<view wx:for="{{list}}" wx:key="id" class="card" bindtap="openDetail" data-id="{{item.id}}">
  <view class="row between">
    <view class="title">{{item.name}}<text class="badge {{item.statusCls}}">{{item.statusText}}</text></view>
    <text class="mini" style="font-weight:700;color:#16202e">{{item.time_start}}</text>
  </view>
  <view style="margin-top:12rpx"><text class="badge {{item.typeCls}}">{{item.typeText}}</text></view>
  <view class="sub" style="margin-top:16rpx">📍 {{item.venue}}　🗓 {{item.date}}</view>
  <view class="row between" style="margin-top:20rpx;font-size:24rpx;color:#5a6478;font-weight:700">
    <text>♂ {{item.signed_m}}/{{item.cap_m}}</text>
    <text>♀ {{item.signed_f}}/{{item.cap_f}}</text>
    <text>共 {{item.signed_total}} 人</text>
  </view>
  <view class="row" style="gap:20rpx;margin-top:8rpx">
    <view style="flex:1" class="bar-track"><view class="bar-m" style="width:{{item.pctM}}%"></view></view>
    <view style="flex:1" class="bar-track"><view class="bar-f" style="width:{{item.pctF}}%"></view></view>
  </view>
  <view class="mini" style="margin-top:16rpx">{{item.status === 'ongoing' ? '🔴 火热进行中 · 点击查看战况 ›' : '点击卡片查看详情并报名 ›'}}</view>
</view>

<view wx:if="{{!list.length}}" class="mini" style="text-align:center;padding:80rpx">暂无有效活动，等群主发局～</view>
